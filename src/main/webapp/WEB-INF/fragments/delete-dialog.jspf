<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<%-- Janela de confirmação de exclusão (elemento <dialog> nativo). O js/app.js a abre quando se
     clica em um botão com data-delete e preenche o endereço, o id e o texto. --%>
<dialog class="dialog" id="delete-dialog" aria-labelledby="delete-title">
	<form method="post" action="">
		<%@ include file="/WEB-INF/fragments/csrf.jspf" %>
		<input type="hidden" name="id" value="" data-delete-id>
		<input type="hidden" name="back" value="<c:out value='${pagination.query}'/>">
		<div class="dialog-body">
			<h2 class="dialog-title" id="delete-title">Excluir <span data-delete-kind>item</span>?</h2>
			<p class="dialog-text" data-delete-text></p>
		</div>
		<div class="dialog-actions">
			<button type="button" class="btn btn-secondary" data-dialog-close>Cancelar</button>
			<button type="submit" class="btn btn-danger" data-delete-confirm><ui:icon name="trash-2"/>Excluir</button>
		</div>
	</form>
</dialog>
